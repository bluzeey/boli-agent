# Boli environment configuration. Copy to .env and fill in.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./boli.db
REDIS_URL=redis://localhost:6379/0
PROCESS_INLINE=true
LOG_LEVEL=INFO

# WhatsApp provider: twilio (Sandbox, the default prototype path) or meta
WHATSAPP_PROVIDER=twilio

# Twilio Sandbox. Activate the Sandbox in your Twilio console (Messaging → Try
# it out → Send a WhatsApp message) and set the values shown there.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Note: the direct Meta WhatsApp Cloud API integration is preserved in code for
# later production use. Set WHATSAPP_PROVIDER=meta and provide the Meta env vars
# (WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET, ...)
# only when you switch off the Twilio Sandbox.

# Sarvam
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix

# Search
SEARCH_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
SEARCH_RESULT_LIMIT=5

# Limits
MAX_AUDIO_BYTES=12000000
MAX_MESSAGE_CHARS=4000
GOOGLE_RESULT_CACHE_MINUTES=30

# Controlled vendor outreach
ALLOW_OUTREACH=true
OUTBOUND_RATE_DELAY_SECONDS=2.0
MAX_OUTREACH_PER_BATCH=20
OUTREACH_CHANNEL=whatsapp
